# Gemini (default, ADR 0010). Bare "gemini-…" model ids use this key.
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: Vercel AI Gateway, for "provider/model" ids such as anthropic/claude-haiku-4.5.
# AI_GATEWAY_API_KEY=

# Optional overrides (plan §11). Defaults are set in src/agents/act.ts.
# MODEL_CIVILIAN=gemini-3.5-flash-lite
# MODEL_IMPOSTER=gemini-3.5-flash
# MODEL_MEMORY=gemini-3.5-flash-lite
